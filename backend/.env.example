# Copy this file to .env.local and fill in your key. Never commit .env.local.
# Get a key at https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=

# Optional overrides
# ASSEMBLYAI_VOICE=george
# Code-card model. The default, qwen3.5-4b-32k-fast, works on every account; stronger
# models need LLM Gateway access on your account (check the model list in your dashboard).
# ASSEMBLYAI_SUGGEST_MODEL=qwen3.5-4b-32k-fast

# Usage metering (optional). Add Upstash Redis from the Vercel Marketplace and
# these are set for you; without them, usage isn't metered and nothing is blocked.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Voice allowance per month: Free is 10 minutes (about 13 questions), Pro is 45 (about 60).
# Minutes count question and answer audio, not the time a session is open.
# ECHOCODE_FREE_SECONDS_PER_MONTH=600
# ECHOCODE_PRO_SECONDS_PER_MONTH=2700
# Comma-separated install ids on the Pro plan.
# ECHOCODE_PRO_INSTALL_IDS=
# Spend guards (need Redis too). Each token opens at most a 15-minute session ($1.13),
# so these bound the worst day: 400 tokens is at most $450 across everyone.
# ECHOCODE_MAX_TOKENS_PER_DAY=400
# ECHOCODE_MAX_TOKENS_PER_IP_PER_DAY=200
