# Copy this file to .env.local and fill in your key. Never commit .env.local.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_LIVE_VOICE=Charon
# GEMINI_API_VERSION=v1alpha
# GEMINI_SUGGEST_MODEL=gemini-3.5-flash-lite

# Freemium metering (optional). Add Upstash Redis from the Vercel Marketplace and
# these are set for you; without them, usage isn't metered and nothing is blocked.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# ECHOCODE_FREE_SECONDS_PER_MONTH=1800
# Comma-separated install ids with unlimited use (the Pro plan).
# ECHOCODE_PRO_INSTALL_IDS=
